<Window x:Class="OCRTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR Translator" Height="400" Width="420"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="#0d0d0f" Foreground="#e8e8ec"
        FontFamily="Segoe UI">

  <Window.Resources>

    <!-- Primary green button -->
    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Background" Value="#00e5a0"/>
      <Setter Property="Foreground" Value="#0d0d0f"/>
      <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#00c98d"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#1e3d35"/>
                <Setter Property="Foreground" Value="#2a6655"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Secondary dark button -->
    <Style x:Key="SecondaryBtn" TargetType="Button">
      <Setter Property="Background" Value="#141416"/>
      <Setter Property="Foreground" Value="#777788"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#2a2a38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#555566"/>
                <Setter Property="Foreground" Value="#aaaacc"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dark TextBox -->
    <Style x:Key="DarkInput" TargetType="TextBox">
      <Setter Property="Background" Value="#141416"/>
      <Setter Property="Foreground" Value="#e8e8ec"/>
      <Setter Property="BorderBrush" Value="#2a2a38"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="CaretBrush" Value="#00e5a0"/>
      <Setter Property="SelectionBrush" Value="#00e5a040"/>
      <Style.Triggers>
        <Trigger Property="IsFocused" Value="True">
          <Setter Property="BorderBrush" Value="#00e5a0"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Label style -->
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="#444455"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

  </Window.Resources>

  <StackPanel Margin="24,22,24,22">

    <!-- Header -->
    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock VerticalAlignment="Center">
        <Run FontFamily="Segoe UI Black" FontSize="22" Foreground="#e8e8ec">OCR </Run>
        <Run FontFamily="Segoe UI Black" FontSize="22" Foreground="#00e5a0">Translator</Run>
      </TextBlock>

      <Button x:Name="BtnReload" Grid.Column="1" Style="{StaticResource SecondaryBtn}"
        Content="Load Mapping" VerticalAlignment="Center"
        Click="BtnReloadSettings_Click"/>
    </Grid>

    <!-- Server URL -->
    <TextBlock Style="{StaticResource Label}">LOCAL SERVER URL</TextBlock>
    <TextBox x:Name="TxtServerUrl" Style="{StaticResource DarkInput}"
             Text="http://localhost:1234" Margin="0,0,0,18"/>

    <!-- Region -->
    <TextBlock Style="{StaticResource Label}">CAPTURE REGION</TextBlock>
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Background="#141416" BorderBrush="#2a2a38" BorderThickness="1"
              CornerRadius="6" Padding="10,7">
        <TextBlock x:Name="TxtRegion" FontFamily="Consolas" FontSize="12"
                   Foreground="#444455" Text="No region selected" VerticalAlignment="Center"/>
      </Border>
      <Button x:Name="BtnSelectRegion" Grid.Column="1" Style="{StaticResource SecondaryBtn}"
              Content="Draw Region" Margin="8,0,0,0" Click="BtnSelectRegion_Click"/>
    </Grid>

    <!-- Mode -->
    <TextBlock Style="{StaticResource Label}">MODE</TextBlock>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
      <RadioButton x:Name="RadioManual" Content="Manual" IsChecked="True"
                   Foreground="#e8e8ec" FontSize="13" VerticalContentAlignment="Center"
                   Margin="0,0,20,0" Checked="RadioManual_Checked"/>
      <RadioButton x:Name="RadioAuto" Content="Auto every"
                   Foreground="#e8e8ec" FontSize="13" VerticalContentAlignment="Center"
                   Margin="0,0,8,0" Checked="RadioAuto_Checked"/>
      <TextBox x:Name="TxtInterval" Style="{StaticResource DarkInput}"
               Text="5" Width="42" TextAlignment="Center"/>
      <TextBlock Foreground="#444455" FontSize="13"
                 VerticalAlignment="Center" Margin="7,0,0,0">seconds</TextBlock>
    </StackPanel>
    <StackPanel x:Name="PanelThreshold" Visibility="Collapsed" Margin="0,0,0,5">
        <TextBlock Style="{StaticResource Label}">CHANGE THRESHOLD (0 = exact, higher = less sensitive)</TextBlock>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="SliderThreshold" Minimum="0" Maximum="50" Value="25"
            IsSnapToTickEnabled="True" TickFrequency="1"
            VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtThresholdValue" Grid.Column="1" Margin="10,0,0,0"
                FontFamily="Consolas" FontSize="12" Foreground="#00e5a0"
                VerticalAlignment="Center" Width="24" Text="25"/>
        </Grid>
    </StackPanel>
      
    <!-- Action buttons -->
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="BtnCapture" Style="{StaticResource PrimaryBtn}"
              Content="Capture &amp; Translate" IsEnabled="False"
              Click="BtnCapture_Click"/>
      <Button x:Name="BtnStop" Grid.Column="1" Style="{StaticResource SecondaryBtn}"
              Content="Stop" Margin="8,0,0,0" Visibility="Collapsed"
              Click="BtnStop_Click"/>
    </Grid>

    <!-- Status bar -->
    <Border Background="#141416" BorderBrush="#1e1e26" BorderThickness="1"
            CornerRadius="6" Padding="12,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,8,0"
                 Fill="#333344" VerticalAlignment="Center"/>
        <TextBlock x:Name="TxtStatus" Grid.Column="1" FontFamily="Consolas" FontSize="11"
                   Foreground="#555566" Text="Select a region to begin" TextWrapping="Wrap"/>
      </Grid>
    </Border>

  </StackPanel>
</Window>
